<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NovaInstaller</RootNamespace>
    <ImageTag Condition="'$(ImageTag)' == ''">latest</ImageTag>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NovaInstaller.Tests" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ImageTag</_Parameter1>
      <_Parameter2>$(ImageTag)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
