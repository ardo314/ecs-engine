<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hand-written companion to the generated Ecs.Protos. Holds the parts of the wire
    contract that are algorithms rather than message shapes — schema hashing, batch
    encoding, payload validation, subject names.

    Engine and Client keep their own copies of the ECS authoring primitives, but not
    of these: a schema hash that differs between two processes is a schema hash that
    does not work, so there is exactly one implementation.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ecs.Protocol</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\proto\gen\csharp\Ecs.Protos.csproj" />
  </ItemGroup>

</Project>
